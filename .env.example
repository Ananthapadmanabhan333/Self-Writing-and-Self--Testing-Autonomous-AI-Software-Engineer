# ============================================================
# NEXUS OS — AUTONOMOUS SOFTWARE ENGINEERING OPERATING SYSTEM
# Environment Configuration Template
# ============================================================

# ---- APPLICATION ----
APP_NAME=nexus-os
APP_ENV=development
APP_VERSION=1.0.0
APP_SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true
LOG_LEVEL=INFO

# ---- AI / LLM CONFIGURATION ----
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
ANTHROPIC_API_KEY=your-anthropic-key
LANGCHAIN_API_KEY=your-langsmith-key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=nexus-os

# ---- DATABASE ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_os
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_secure_password
DATABASE_URL=postgresql+asyncpg://nexus:nexus_secure_password@localhost:5432/nexus_os

# ---- REDIS ----
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/2

# ---- VECTOR DATABASE (QDRANT) ----
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_CODE=nexus_code_embeddings
QDRANT_COLLECTION_MEMORY=nexus_engineering_memory

# ---- ELASTICSEARCH ----
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=elastic_password

# ---- KAFKA ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_TASKS=nexus.engineering.tasks
KAFKA_TOPIC_EVENTS=nexus.engineering.events
KAFKA_TOPIC_TELEMETRY=nexus.telemetry

# ---- GITHUB INTEGRATION ----
GITHUB_TOKEN=ghp_your_github_token
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY_PATH=/secrets/github-app.pem

# ---- DEPLOYMENT INTEGRATIONS ----
# Vercel
VERCEL_TOKEN=your-vercel-token
VERCEL_TEAM_ID=your-team-id

# Railway
RAILWAY_TOKEN=your-railway-token

# AWS
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# GCP
GCP_PROJECT_ID=your-gcp-project
GCP_SERVICE_ACCOUNT_KEY_PATH=/secrets/gcp-key.json

# Azure
AZURE_SUBSCRIPTION_ID=your-azure-subscription
AZURE_TENANT_ID=your-azure-tenant
AZURE_CLIENT_ID=your-azure-client
AZURE_CLIENT_SECRET=your-azure-secret

# ---- KUBERNETES / ARGOCD ----
KUBECONFIG_PATH=/secrets/kubeconfig
ARGOCD_URL=https://argocd.your-domain.com
ARGOCD_TOKEN=your-argocd-token

# ---- MONITORING & OBSERVABILITY ----
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
GRAFANA_API_KEY=your-grafana-api-key
JAEGER_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ---- SANDBOX EXECUTION ----
DOCKER_HOST=unix:///var/run/docker.sock
SANDBOX_NETWORK=nexus_sandbox
SANDBOX_MAX_CPU=0.5
SANDBOX_MAX_MEMORY=512m
SANDBOX_MAX_TIMEOUT=300

# ---- SECURITY ----
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# ---- FRONTEND ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=NEXUS OS

# ---- CELERY WORKERS ----
CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_MAX_TASKS_PER_CHILD=100

# ---- FEATURE FLAGS ----
ENABLE_AUTONOMOUS_MODE=true
ENABLE_SELF_HEALING=true
ENABLE_AUTO_DEPLOY=false
ENABLE_KNOWLEDGE_GRAPH=true
ENABLE_MULTI_AGENT=true
